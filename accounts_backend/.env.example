# Example environment variables for accounts_backend
PORT=3001
HOST=0.0.0.0

# JWT
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# MySQL connection (provided by orchestrator in CI/production)
MYSQL_URL=127.0.0.1
MYSQL_USER=myuser
MYSQL_PASSWORD=mypassword
MYSQL_DB=accounts_db
MYSQL_PORT=3306
